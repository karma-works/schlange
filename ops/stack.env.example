# Copy to /etc/schlange/stack.env (0600), then review image pins and fill in site details.
# These Caddy 2.10.2 / Squid 6.13 pins were used for the template's configuration checks.
SCHLANGE_IMAGE=schlange:dev
CADDY_IMAGE=caddy@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
SQUID_IMAGE=ubuntu/squid@sha256:6a097f68bae708cedbabd6188d68c7e2e7a38cedd05a176e1cc0ba29e3bbe029
SCHLANGE_HOST=queue.example.org
ACME_EMAIL=operations@example.org
SCHLANGE_GITHUB_APP_ID=123456
SCHLANGE_REPOS=owner/repository
# Start with the dedicated read-only App. Active mode requires a separate reviewed cutover.
SCHLANGE_SHADOW=true
SCHLANGE_ROOT=/var/lib/schlange
SCHLANGE_SECRETS=/etc/schlange/secrets
