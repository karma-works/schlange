{
  "name": "Schlange Shadow",
  "description": "Schlange in shadow mode: read-only permissions, decides without acting.",
  "public": false,
  "default_permissions": {
    "metadata": "read",
    "contents": "read",
    "pull_requests": "read",
    "checks": "read",
    "statuses": "read"
  },
  "default_events": [
    "check_run",
    "check_suite",
    "issue_comment",
    "pull_request",
    "pull_request_review",
    "push",
    "status"
  ],
  "webhook": true
}
