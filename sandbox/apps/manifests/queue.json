{
  "name": "Schlange Sandbox Queue",
  "description": "Schlange as the merge queue in the sandbox organisation (E2E tests).",
  "public": false,
  "default_permissions": {
    "metadata": "read",
    "contents": "write",
    "pull_requests": "write",
    "issues": "write",
    "checks": "write",
    "statuses": "read",
    "workflows": "write"
  },
  "default_events": [
    "check_run",
    "check_suite",
    "issue_comment",
    "pull_request",
    "pull_request_review",
    "push",
    "status"
  ],
  "webhook": true
}
