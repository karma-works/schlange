    {
      "wait": "quiet",
      "seconds": 300,
      "timeout": 1800
    },
    {
      "comment": "a",
      "text": "@mergifyio queue",
      "as": "driver"
    },
    {
      "wait": "quiet",
      "seconds": 180,
      "timeout": 1200
    },
    {
      "comment": "a",
      "text": "@mergifyio queue",
      "as": "human"
    },
    {
      "wait": "done",
