{
  "id": "S08",
  "title": "A constitution path is not enqueued automatically; @mergifyio queue only from the allowed sender",
  "refs": [
    "MQ-50",
    "MQ-52"
  ],
  "steps": [
    {
      "open": "a",
      "files": {
        "governance/rule.txt": "Constitution change in the scenario\n"
      }
    },
    {
      "wait": "quiet",
      "seconds": 300,
      "timeout": 1800
    },
    {
      "comment": "a",
      "text": "@mergifyio queue",
      "as": "driver"
    },
    {
      "wait": "quiet",
      "seconds": 180,
      "timeout": 1200
    },
    {
      "comment": "a",
      "text": "@mergifyio queue",
      "as": "human"
    },
    {
      "wait": "done",
      "prs": [
        "a"
      ],
      "timeout": 2400
    }
  ]
}
