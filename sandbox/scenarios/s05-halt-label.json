{
  "id": "S05",
  "title": "Label halt while queued: dequeue with a reason; removing it does not queue it again (it waits for a new head)",
  "refs": [
    "MQ-11",
    "MQ-12",
    "MQ-45"
  ],
  "steps": [
    {
      "open": "a",
      "flags": [
        "sleep-full 240"
      ]
    },
    {
      "sleep": 90
    },
    {
      "label": "a",
      "add": "halt",
      "as": "human"
    },
    {
      "sleep": 120
    },
    {
      "label": "a",
      "remove": "halt",
      "as": "human"
    },
    {
      "wait": "quiet",
      "seconds": 600,
      "timeout": 2400
    }
  ]
}
